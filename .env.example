# Copy to .env and fill in. Never commit .env.

# Shared secret the portal sends in the X-Service-Key header. Empty disables the check (local dev only).
SERVICE_KEY=

# Only when the portal page calls this service on another address (its appSettings "ai" set to this service's URL)
# instead of through the portal's own /ai/ path: the portal's origins, comma-separated, e.g. http://localhost:44300
CORS_ORIGINS=

# Which AI reviews the documents: claude | openai | gemini | local
# Only the key and model of the chosen provider are needed.
AI_PROVIDER=claude
AI_TIMEOUT_SECONDS=600

# --- Claude (https://platform.claude.com) ---
# If left empty, the SDK falls back to the ANTHROPIC_API_KEY environment variable or an `ant auth login` profile.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=64000
# Re-run a declined request on a fallback model (server-side fallback beta)
CLAUDE_REFUSAL_FALLBACK=true

# --- OpenAI (https://platform.openai.com), or any OpenAI-compatible service ---
OPENAI_API_KEY=
# Check the provider's model list for current names
OPENAI_MODEL=gpt-5
# Empty for OpenAI itself. Set it to use another OpenAI-compatible service, for example
# OpenRouter (one key for models from many vendors): https://openrouter.ai/api/v1
# with OPENAI_MODEL like google/gemini-2.5-pro or openai/gpt-5. The model must accept PDF input.
OPENAI_BASE_URL=
# Reasoning models only: minimal | low | medium | high. Leave empty for other models.
OPENAI_REASONING_EFFORT=

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- Local model through Ollama (https://ollama.com), runs on this machine, no API key ---
# Download a model first, e.g. `ollama pull gemma3:4b`. Ollama must be running (tray icon).
# On a CPU-only laptop a review is slow (minutes per slide), so raise AI_TIMEOUT_SECONDS.
LOCAL_BASE_URL=http://localhost:11434
LOCAL_MODEL=gemma3:4b
# false: send each slide's text only (faster). true: also send slide images, needs a vision model (gemma3, qwen2.5vl)
LOCAL_SEND_IMAGES=false
# Context window; must fit the whole deck plus the answer
LOCAL_CONTEXT_TOKENS=32768

# LibreOffice, used to convert .pptx to .pdf
SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
CONVERSION_TIMEOUT_SECONDS=180

# The portal page allows 50 MB. Claude takes ~32 MB per request and base64 adds ~33%, so a PDF over ~24 MB
# (after .pptx conversion, which usually shrinks it) is rejected by Claude with an error message.
MAX_UPLOAD_MB=50

LOG_LEVEL=INFO
